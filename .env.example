# Copy to .env and fill in real values. This file is synced to the EC2 host
# by GitHub Actions (the real .env is generated from GitHub Secrets, never committed).

# ----- Domain / TLS -----
DOMAIN_NAME=n8n.londoso.com
# Email used by Let's Encrypt for expiry notices
ACME_EMAIL=you@londoso.com

# ----- Postgres -----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=n8n

# ----- n8n access -----
# Modern n8n has built-in user management: the first time you open the editor
# it asks you to create the owner account (email + password). No basic-auth vars.

# ----- n8n encryption key -----
# Generate once with: openssl rand -hex 32
# KEEP THIS STABLE. Changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ----- Misc -----
GENERIC_TIMEZONE=America/Bogota
